# CrossCheck 环境变量配置示例
# 复制此文件为 .env，并填入真实值

# ====================================
# Monad 测试网配置
# ====================================
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
CHAIN_MODE=monad

# ====================================
# 合约信息（部署后填写）
# ====================================
CONTRACT_ADDRESS=
ISSUER_ADDRESS=
DEPLOYMENT_BLOCK=

# ====================================
# 钱包私钥（⚠️ 绝对不要提交到 Git）
# ====================================
PRIVATE_KEY=

# ====================================
# AI API Keys
# ====================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 填写账户实际可调用的 API model ID；不会从桌面订阅读取。
ANTHROPIC_MODEL=
OPENAI_MODEL=

# ====================================
# 服务器配置
# ====================================
PORT=5173
HOST=127.0.0.1
MODE=demo
NODE_ENV=development

# ====================================
# 前端配置（可选）
# ====================================
# 同一Wi-Fi扫码时改为本机局域网地址，HOST=0.0.0.0。
PUBLIC_ORIGIN=
# 队友API可访问时填写它的origin，留空使用内置集成后端。
BACKEND_ORIGIN=
