# Copy to .env in repo root. Never commit real .env or credentials.
MODE=demo
HOST=127.0.0.1
PORT=3001
PUBLIC_ORIGIN=http://localhost:5173
DATA_DIR=./data
MAX_INPUT_CHARS=12000
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_JOBS=2
MAX_QUEUE_SIZE=20
MODEL_TIMEOUT_MS=20000
CACHE_TTL_MS=3600000
CHAIN_TIMEOUT_MS=30000
RECOVERY_INTERVAL_MS=15000

# MODE=live requires both official provider credentials and model IDs.
# Pick model IDs available in your provider account; no guessed defaults.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# B supplies the real chain module + deployment.json; demo never broadcasts.
CHAIN_ENABLED=false
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
DEPLOYMENT_FILE=./deployment.json
ISSUER_PRIVATE_KEY=
